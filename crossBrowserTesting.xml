<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="CrossBrowserSuite" parallel="tests" thread-count="3">

	<test name="ChromeTest">
		<parameter name="browser" value="chrome" />
		<classes>
			<class name="testCases.TC_0001LoginPageTestclass" />
			<class name="testCases.TC_0002EmployeeManagementCard" />
			<class name="testCases.TC_0003AssignIndividualTestclass" />
			<class name="testCases.TC_0004UnmapTestclass" />
			<class name="testCases.TC_0005AssignRoleTestclass" />
			<class name="testCases.TC_0006UnAssignRoleTestClass" />
		</classes>
	</test>

	<test name="FirefoxTest">
		<parameter name="browser" value="firefox" />
		<classes>
			<class name="testCases.TC_0001LoginPageTestclass" />
			<class name="testCases.TC_0002EmployeeManagementCard" />
			<class name="testCases.TC_0003AssignIndividualTestclass" />
			<class name="testCases.TC_0004UnmapTestclass" />
			<class name="testCases.TC_0005AssignRoleTestclass" />
			<class name="testCases.TC_0006UnAssignRoleTestClass" />
		</classes>
	</test>

	<test name="EdgeTest">
		<parameter name="browser" value="edge" />
		<classes>
			<class name="testCases.TC_0001LoginPageTestclass" />
			<class name="testCases.TC_0002EmployeeManagementCard" />
			<class name="testCases.TC_0003AssignIndividualTestclass" />
			<class name="testCases.TC_0004UnmapTestclass" />
			<class name="testCases.TC_0005AssignRoleTestclass" />
			<class name="testCases.TC_0006UnAssignRoleTestClass" />
		</classes>
	</test>

</suite>